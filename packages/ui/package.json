{
  "name": "@uploadrescue/ui",
  "version": "0.1.0",
  "description": "Shared view model, DOM renderer and accessible styles for UploadRescue recovery widgets.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madhavbuilds/uploadrescue.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/madhavbuilds/uploadrescue#readme",
  "bugs": "https://github.com/madhavbuilds/uploadrescue/issues",
  "keywords": [
    "upload",
    "file-upload",
    "compression",
    "retry",
    "recovery"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uploadrescue/core": "workspace:^",
    "@uploadrescue/image-engine": "workspace:^"
  }
}
