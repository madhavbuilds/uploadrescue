{
  "name": "@uploadrescue/core",
  "version": "0.1.0",
  "description": "Framework-independent upload failure detection, classification, optimization orchestration and recovery state machine.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madhavbuilds/uploadrescue.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/madhavbuilds/uploadrescue#readme",
  "bugs": "https://github.com/madhavbuilds/uploadrescue/issues",
  "keywords": [
    "upload",
    "file-upload",
    "compression",
    "retry",
    "recovery",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  }
}
