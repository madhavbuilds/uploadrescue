{
  "name": "@uploadrescue/image-engine",
  "version": "0.1.0",
  "description": "Browser image optimization for UploadRescue: JPEG, PNG, WebP, AVIF, static GIF and sanitized SVG, with Web Worker processing.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madhavbuilds/uploadrescue.git",
    "directory": "packages/image-engine"
  },
  "homepage": "https://github.com/madhavbuilds/uploadrescue#readme",
  "bugs": "https://github.com/madhavbuilds/uploadrescue/issues",
  "keywords": [
    "upload",
    "file-upload",
    "compression",
    "retry",
    "recovery",
    "image",
    "compression",
    "webp",
    "svg"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build-worker.mjs && tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uploadrescue/core": "workspace:^"
  }
}
